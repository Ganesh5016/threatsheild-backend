# ============================================================
# THREATSHIELD BACKEND — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── App ──────────────────────────────────────────────────
APP_NAME=ThreatShield
APP_VERSION=2.4.1
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://yourdomain.com

# ── Database ─────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/threatshield

# SQLite (development — no setup needed)
# DATABASE_URL=sqlite+aiosqlite:///./threatshield.db

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=200

# ── File Upload ──────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=.apk,.exe,.pdf,.zip,.rar,.dmg,.msi,.js,.html,.bat,.sh,.ps1

# ── Scan Timeouts ────────────────────────────────────────
URL_SCAN_TIMEOUT_SECONDS=15
FILE_SCAN_TIMEOUT_SECONDS=30
APK_SCAN_TIMEOUT_SECONDS=45

# ── External Threat Intelligence APIs ────────────────────
# VirusTotal (free tier: 4 req/min, 500 req/day)
# Get key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# URLScan.io (free: 100 scans/day)
# Get key at: https://urlscan.io/user/signup
URLSCAN_API_KEY=your_urlscan_api_key_here

# AbuseIPDB (free: 1000 req/day)
# Get key at: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# PhishTank (free, no key needed for basic)
# Register at: https://www.phishtank.com/register.php
PHISHTANK_API_KEY=your_phishtank_api_key_here

# Google Safe Browsing (free: 10k req/day)
# Get key at: https://console.cloud.google.com
GOOGLE_SAFE_BROWSING_API_KEY=your_google_api_key_here

# IPQualityScore (free: 200 req/day)
# Get key at: https://www.ipqualityscore.com/create-account
IPQS_API_KEY=your_ipqs_api_key_here

# Shodan (optional, for IP intelligence)
SHODAN_API_KEY=your_shodan_api_key_here

# ── YARA Rules ───────────────────────────────────────────
YARA_RULES_DIR=./app/core/yara_rules

# ── Celery (Background Tasks) ────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT Auth ─────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
